# CodeLab's existing PostgreSQL server AND database; never create another database.
PENPOT_VERSION=2.19.0
PENPOT_PUBLIC_URI=https://your-codelab-domain/penpot/
# Penpot expects a PostgreSQL URI (not a JDBC URL).
# Use a dedicated least-privilege role whose search_path is penpot,public.
PENPOT_DATABASE_URI=postgresql://YOUR_DB_HOST:5432/YOUR_EXISTING_DB?sslmode=require
PENPOT_DATABASE_USERNAME=codelab_penpot
PENPOT_DATABASE_PASSWORD=SET_A_UNIQUE_LONG_PASSWORD
# Internal signing key for Penpot; not a user credential.
PENPOT_SECRET_KEY=replace-with-a-unique-random-512-bit-secret
# Existing CodeLab persistent directory. The Penpot backend writes only to its /penpot subdirectory.
CODELAB_DATA_DIR=/path/to/existing/codelab/data
# Local reverse-proxy upstream only; never expose this port publicly.
PENPOT_FRONTEND_URL=http://127.0.0.1:9001
