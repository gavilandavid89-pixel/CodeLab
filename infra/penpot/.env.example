# Existing CodeLab resources — do not create a second user/project database.
PENPOT_VERSION=2.18
PENPOT_PUBLIC_URI=https://your-codelab-domain/penpot/
# JDBC URL to the SAME PostgreSQL database already used by CodeLab.
# Use a dedicated "penpot" schema within that database (currentSchema=penpot).
PENPOT_DATABASE_URI=jdbc:postgresql://YOUR_EXISTING_DB_HOST:5432/YOUR_EXISTING_DB?currentSchema=penpot&sslmode=require
PENPOT_DATABASE_USERNAME=YOUR_EXISTING_DB_USER
PENPOT_DATABASE_PASSWORD=YOUR_EXISTING_DB_PASSWORD
# Secret for Penpot's internal signing/session mechanisms, not a user credential.
PENPOT_SECRET_KEY=replace-with-a-unique-random-512-bit-secret
# Mount the SAME persistent directory already used by CodeLab; assets go under /penpot.
CODELAB_DATA_DIR=/path/to/existing/codelab/data
# Local reverse-proxy upstream only; not a public URL.
PENPOT_FRONTEND_URL=http://127.0.0.1:9001
