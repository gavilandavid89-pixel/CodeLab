{
  "name": "codelab-xd-studio-pro",
  "version": "2.7.0",
  "description": "CodeLab XD Studio Pro - Editor web multiproyecto con ramas, sincronización segura y control de versiones",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test:native-headless": "node --test --test-concurrency=1 tests/native-headless-worker-contract.test.mjs tests/native-headless-video-runtime.test.mjs tests/pixelforge-frame-context.test.mjs tests/heavy-headless-visual-e2e.test.mjs",
    "postinstall": "node scripts/install-playwright-ffmpeg.mjs",
    "test:heavy-visual": "node --test --test-concurrency=1 tests/heavy-visual-evidence.e2e.test.mjs",
    "test:pixelforge-illustration": "node --test tests/pixelforge-illustration-scene.test.mjs tests/pixelforge-drawing-workflow.test.mjs tests/pixelforge-vector-studio.test.mjs",
    "test:pixelforge-validation": "node --test tests/pixelforge-validation.test.mjs",
    "test:pixelforge": "node --test tests/codelab-validation-engine.test.mjs tests/pixelforge-validation.test.mjs tests/pixelforge-vector-studio.test.mjs tests/pixelforge-illustration-scene.test.mjs tests/pixelforge-drawing-workflow.test.mjs",
    "test:native-validation": "node --test --test-concurrency=1 tests/codelab-validation-engine.test.mjs tests/pixelforge-validation.test.mjs"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "@sparticuz/chromium": "^153.0.0",
    "playwright-core": "^1.64.1"
  }
}
